# Telegram
TELEGRAM_BOT_TOKEN=8659982376:AAH...
TELEGRAM_CHANNEL_ID=@safespaceoriginal

# Pinterest source
PINTEREST_PROVIDER=rebix
PINTEREST_ENDPOINT=https://api-rebix.zone.id/api/pinterest
# For official provider only:
# PINTEREST_ACCESS_TOKEN=
PINTEREST_COUNTRY_CODE=NG
PINTEREST_LOCALE=en-US

# Scheduling
POST_INTERVAL=3600
RUN_ON_START=false

# Content
IMAGES_PER_POST=1
SEARCH_RESULTS_PER_QUERY=20
MIN_IMAGE_WIDTH=300
MIN_IMAGE_HEIGHT=300
MAX_DOWNLOAD_BYTES=15000000
MAX_TELEGRAM_IMAGE_BYTES=9500000
MAX_RETRIES=3
REQUIRE_SOURCE_LINK=true
SKIP_SPONSORED=true
ENABLE_CLASSIFIER=true

# Storage
DATABASE_PATH=./data/bot.db
DOWNLOAD_DIR=./downloads

# Logging
LOG_LEVEL=info
